{
  "index_patterns": ["logs-opc-*"],
  "data_stream": {},
  "template": {
    "settings": {
      "index.lifecycle.name": "opc-logs-policy-ha",
      "index.routing.allocation.include._tier_preference": "data_hot",
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "service": {
          "type": "keyword"
        },
        "level": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        },
        "env": {
          "type": "keyword"
        }
      }
    }
  },
  "priority": 600
}
