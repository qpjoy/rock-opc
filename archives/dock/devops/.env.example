COMPOSE_PROJECT_NAME=opc-devops

# Shared ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Elastic Stack
ELASTIC_VERSION=8.13.4
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_BEATS_PORT=5044
LOGSTASH_TCP_JSON_PORT=5000
FILEBEAT_HTTP_PORT=5066
ELASTICSEARCH_HEAP=1g
LOGSTASH_HEAP=512m
KIBANA_MEMORY_LIMIT=1g
SNAPSHOT_INTERVAL_SECONDS=86400
SNAPSHOT_RETENTION_COUNT=7

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8081
ELASTICSEARCH_EXPORTER_PORT=9114
BLACKBOX_EXPORTER_PORT=9115

# CI/CD
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000
GITLAB_HTTP_PORT=8929
GITLAB_HTTPS_PORT=8443
GITLAB_SSH_PORT=2224
GITLAB_HOST=gitlab.local

# Time zone
TZ=Asia/Shanghai
